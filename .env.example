APP_NAME="Aine"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost
MAX_FILE_SIZE=8M
APP_VERSION=2.0.0

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database
DB_USERNAME=username
DB_PASSWORD=

BROADCAST_DRIVER=log

# Cache / session: `file` is fine on a single server. For multi-instance
# (load-balanced) deployments switch to `redis` — set CACHE_DRIVER=redis and
# SESSION_DRIVER=redis (fill REDIS_* below) so the per-project cache version
# and sessions are shared across instances.
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue: content webhooks are dispatched through the queue (Spatie Webhook
# Server, default connection) and `aine:publish_scheduled` queues the timed
# publish job. `sync` runs each one inside the triggering request — dev only.
# For production use `database` (no extra service, uses the `jobs` table) or
# `redis`, and run a `php artisan queue:work` daemon. See the README
# "Production deployment → Queue" section.
QUEUE_CONNECTION=database

# ⚠️  CRON (production critical): the Laravel task scheduler powers
# `aine:publish_scheduled` (timed content publishing). Without this cron
# entry, content with a `scheduled_at` date will never be published.
# Add to every production server:
#
#   * * * * * cd /path-to-project && php artisan schedule:run >> /dev/null 2>&1
#
# See README "Production deployment → Task scheduler" for details.

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=username
MAIL_PASSWORD=password
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Cloudflare Turnstile protects public (embedded) form submissions.
# Leave both empty to disable the human verification challenge.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
